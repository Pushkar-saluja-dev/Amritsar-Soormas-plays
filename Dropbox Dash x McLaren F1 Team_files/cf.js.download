ccess?cta=signup\"]';\n  var clickArmed = false;\n  var scrollArmed = false;\n  var scrollHandler = null;\n\n  function getThreshold() {\n    var isMobile = window.innerWidth < MOBILE_BREAKPOINT;\n    return isMobile ? MOBILE_THRESHOLD : DESKTOP_THRESHOLD;\n  }\n\n  function checkScrollDepth() {\n    if (sessionStorage.getItem(SEEN_KEY) === 'true') return true;\n    var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;\n    var scrollHeight = document.documentElement.scrollHeight || document.body.scrollHeight || 0;\n    var viewportHeight = window.innerHeight || 0;\n    var docHeight = scrollHeight - viewportHeight;\n    if (docHeight <= 0) return false;\n    var scrollPct = scrollTop / docHeight;\n    var threshold = getThreshold();\n    if (scrollPct >= threshold) {\n      var deviceLabel = window.innerWidth < MOBILE_BREAKPOINT ? 'mobile' : 'desktop';\n      console.warn('[CFQ Metric] Scroll threshold reached on ' + deviceLabel + ' (' + Math.round(scrollPct * 100) + '% / threshold ' + Math.round(threshold * 100) + '%) — armed for conversion');\n      sessionStorage.setItem(SEEN_KEY, 'true');\n      return true;\n    }\n    return false;\n  }\n\n  function armScrollListener() {\n    if (scrollArmed) return;\n    scrollArmed = true;\n    if (checkScrollDepth()) return;\n    var ticking = false;\n    scrollHandler = function() {\n      if (!ticking) {\n        window.requestAnimationFrame(function() {\n          if (checkScrollDepth() && scrollHandler) {\n            window.removeEventListener('scroll', scrollHandler);\n            scrollHandler = null;\n          }\n          ticking = false;\n        });\n        ticking = true;\n      }\n    };\n    window.addEventListener('scroll', scrollHandler, { passive: true });\n  }\n\n  function armClickListener() {\n    if (clickArmed) return;\n    clickArmed = true;\n    console.warn('[CFQ Metric] Click delegation armed for: ' + CTA_SELECTOR);\n    document.addEventListener('click', function(e) {\n      var cta = e.target && e.target.closest && e.target.closest(CTA_SELECTOR);\n      if (!cta) return;\n      if (sessionStorage.getItem(SEEN_KEY) !== 'true') {\n        console.warn('[CFQ Metric] CTA clicked but scroll threshold NOT reached — skipping');\n        return;\n      }\n      console.warn('[CFQ Metric] SUCCESS: CTA clicked after scroll threshold — firing conversion for metricId: ' + args.metricId);\n      window.CFQ = window.CFQ || [];\n      window.CFQ.push({\n        emit: 'conversion',\n        payload: { metricId: args.metricId, metricName: args.metricName }\n      });\n    }, true);\n  }\n\n  function init() {\n    armClickListener();\n    armScrollListener();\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n}"},{"id":"69eeba8f26f78637d1b77888","selector":{"name":"features_module_pill_click_after_seen"}},{"id":"69eeba8ffde190293e4f5c96","selector":{"name":"features_module_cta_click_after_seen"}},{"id":"69eec30efde190293e4f5c9c","selector":{"css":"a:has([data-pill=\"Search widely\"])","event_type":"click"}},{"id":"69eec30efde190293e4f5c9d","selector":{"css":"a:has([data-pill=\"Get answers\"])"}},{"id":"69eec31326f78637d1b7788a","selector":{"css":"a:has([data-pill=\"Create faster\"])"}},{"id":"69eec315fde190293e4f5c9e","selector":{"css":"a:has([data-pill=\"Stay aligned\"])"}}],"settings":{"mutation_observer_active":true,"track_only_activated_frames":false,"bot_cloaking_enabled":false,"bot_score_threshold":30},"tags":[{"name":"Dash HP | Scroll Depth Download/Signup CTA Clicks (Control)","js":"/**\n * ============================================================================\n * Dropbox Dash Homepage — Metric Tracker (Coframe Global Tag v4)\n * ============================================================================\n *\n * Fires named conversion events for scroll-aware click metrics on\n * dash.dropbox.com.\n *\n * Why this lives in a Global Tag (not a metric js_binder):\n *   The Dash production CSP blocks dynamically-evaluated scripts, which is\n *   how Coframe metric js_binders execute. Global Tags ship with the main\n *   Coframe bundle and run cleanly inside the existing CSP allowlist.\n *\n * Architecture: small registry of \"scroll-gated click metrics\". Each entry\n * declares anchors, threshold, click selectors, and the metric name to fire.\n *\n * Anchor strategy (multi-anchor scroll depth):\n *   1. We capture the absolute page position of the FIRST candidate anchor\n *      we can find using `getBoundingClientRect().top + window.scrollY`.\n *      This is page-relative regardless of CSS nesting / position context.\n *   2. The gate trips when the user scrolls such that\n *      `scrollY + innerHeight >= anchorTop + REVEAL_OFFSET_PX`.\n *   3. We re-measure on a slow interval to handle late-loading content\n *      (lazy images, async hydration) that changes layout above the anchor.\n *   4. Once the gate fires, all observers/intervals are torn down.\n *\n * Why scroll depth instead of IntersectionObserver:\n *   - More resilient to variant DOM changes (anchor element removal,\n *     restructuring, hiding). Once we've captured a page position, even\n *     if the anchor disappears we can still fire when the user reaches\n *     the right depth.\n *   - Independent of element visibility (display:none, opacity:0, etc.)\n *   - Continues to work if the page changes drastically — we just need\n *     ANY of our candidate anchors to exist on first measurement.\n *\n * Why sessionStorage (not localStorage):\n *   - Per-session state. Yesterday's scroll doesn't credit today's click.\n *   - Resets on browser close, matching Coframe's session model.\n *\n * Why we DON'T clear the seen flag after firing:\n *   - We let CFQ deduplicate conversions per session.\n *   - Avoids the bug where a re-engaged user loses credit.\n *\n * To add a new scroll-gated metric, append an entry to METRICS. Plumbing\n * handles the rest.\n * ============================================================================\n */\n\n;(function () {\n  // -------------------- 0. Scope guard --------------------\n  if (window.location.hostname !== 'dash.dropbox.com') return;\n  if (window.location.pathname !== '/' && window.location.pathname !== '') return;\n  if (window.__cfDashHomepageMetricsBound) return;\n  window.__cfDashHomepageMetricsBound = true;\n\n  var DEBUG = true; // flip to false in production once verified\n  function log() {\n    if (!DEBUG) return;\n    try {\n      var args = ['[CFQ Metrics]'].concat(Array.prototype.slice.call(arguments));\n      console.warn.apply(console, args);\n    } catch (e) {}\n  }\n\n  log('Initializing on', window.location.href);\n\n  // -------------------- 1. CFQ helper --------------------\n  function fireConversion(metricName, ctx) {\n    window.CFQ = window.CFQ || [];\n    window.CFQ.push({ conversion: { metricName: metricName } });\n    log('FIRED →', metricName, ctx || '');\n  }\n\n  // Absolute page position of an element (handles nested positioned\n  // ancestors correctly, unlike el.offsetTop).\n  function pageTop(el) {\n    var rect = el.getBoundingClientRect();\n    return rect.top + (window.scrollY || window.pageYOffset || 0);\n  }\n\n  // Find the first existing anchor in a list of selectors.\n  function findFirstAnchor(selectors) {\n    for (var i = 0; i < selectors.length; i++) {\n      var el = document.querySelector(selectors[i]);\n      if (el) return { el: el, selector: selectors[i] };\n    }\n    return null;\n  }\n\n  // -------------------- 2. Metric Registry --------------------\n  // Each entry:\n  //   id              — unique storage key + log identifier\n  //   metricName      — Coframe metric `name` selector value\n  //   anchors         — array of CSS selectors. We use the first match\n  //                     to compute the scroll-depth target. Order = priority.\n  //                     Pick anchors that ALWAYS render on the page (not\n  //                     hidden behind tabs etc.) for best reliability.\n  //   revealOffsetPx  — pixels past the anchor's top before firing the gate.\n  //                     Default 200. Higher = \"scrolled meaningfully past\".\n  //   ctas            — CSS selectors for click targets that fire the metric.\n  //   matchPredicate  — optional fn(clickedEl) for finer scoping.\n  var METRICS = [\n    // ----------------------------------------------------------\n    // [DROP-097](/695feaaaadfeb111c54f7fd9/695feaaaadfeb111c54f7fdb/gantt/DROP-097) continuation: Signup/Download click after features\n    // section seen. Replaces broken metric 69d818d8640861e6a8dd7f70.\n    // ----------------------------------------------------------\n    {\n      id: 'signup-after-features-seen',\n      metricName: 'signup_download_after_features_seen',\n      anchors: [\n        '.home-feature_tagline',     // primary — visible, real page position\n        '.home3-modular_grid',       // fallback — large active tab pane\n        '.home-features_tab-link',   // fallback — pill nav strip\n        '.section_home2-modular'     // fallback — section wrapper\n      ],\n      revealOffsetPx: 200,\n      ctas: [\n        'a[dash-element=\"download\"]',\n        'a[href*=\"dropbox.com/dash/access?cta=signup\"]'\n      ]\n    },\n\n    // ----------------------------------------------------------\n    // [DROP-107](/695feaaaadfeb111c54f7fd9/695feaaaadfeb111c54f7fdb/gantt/DROP-107): Per-tab \"Learn more\" CTA click after features\n    // section seen. Same selector for control + variant.\n    // ----------------------------------------------------------\n    {\n      id: 'features-cta-after-seen',\n      metricName: 'features_module_cta_click_after_seen',\n      anchors: [\n        '.home-feature_tagline',\n        '.home3-modular_grid',\n        '.home-features_tab-link',\n        '.section_home2-modular'\n      ],\n      revealOffsetPx: 200,\n      ctas: [\n        '.home-features_tab-pane .home3-modular_left-wrapper > a.button'\n      ]\n    },\n\n    // ----------------------------------------------------------\n    // [DROP-107](/695feaaaadfeb111c54f7fd9/695feaaaadfeb111c54f7fdb/gantt/DROP-107): Pill click after features section seen.\n    // Same .home-features_tab-link selector for control + variant.\n    // ----------------------------------------------------------\n    {\n      id: 'features-pill-after-seen',\n      metricName: 'features_module_pill_click_after_seen',\n      anchors: [\n        '.home-feature_tagline',\n        '.home3-modular_grid',\n        '.home-features_tab-link',\n        '.section_home2-modular'\n      ],\n      revealOffsetPx: 200,\n      ctas: [\n        '.home-features_tab-link'\n      ]\n    }\n  ];\n\n  // -------------------- 3. Gate state per metric --------------------\n  // Map<metricId, { seen: bool, anchorTop: number|null, selector: string|null }>\n  var gateState = {};\n  METRICS.forEach(function (m) {\n    var sessionSeen = false;\n    try { sessionSeen = sessionStorage.getItem('cf-gate-' + m.id) === '1'; } catch (e) {}\n    gateState[m.id] = {\n      seen: sessionSeen,\n      anchorTop: null,\n      selector: null\n    };\n    if (sessionSeen) log('Gate already seen this session for', m.id);\n  });\n\n  function markSeen(metricId, why) {\n    var s = gateState[metricId];\n    if (s.seen) return;\n    s.seen = true;\n    try { sessionStorage.setItem('cf-gate-' + metricId, '1'); } catch (e) {}\n    log('GATE TRIPPED for', metricId, '— reason:', why);\n  }\n\n  // -------------------- 4. Anchor measurement --------------------\n  // Captures the page-absolute Y of each metric's anchor.\n  // Re-measures on an interval until either the gate fires or we time out,\n  // since lazy-loaded images / async hydration can change layout.\n  function measureAnchors() {\n    METRICS.forEach(function (m) {\n      var s = gateState[m.id];\n      if (s.seen) return;\n      var found = findFirstAnchor(m.anchors);\n      if (!found) {\n        if (s.anchorTop === null) log('Anchor not yet found for', m.id);\n        return;\n      }\n      var newTop = pageTop(found.el);\n      // Only log when the value materially changes (avoids spam).\n      if (s.anchorTop === null || Math.abs(newTop - s.anchorTop) > 4) {\n        log('Anchor measured for', m.id, '→', found.selector, '@ pageTop=', Math.round(newTop));\n      }\n      s.anchorTop = newTop;\n      s.selector = found.selector;\n    });\n  }\n\n  // -------------------- 5. Scroll evaluation --------------------\n  var rafScheduled = false;\n  function scheduleEvaluate() {\n    if (rafScheduled) return;\n    rafScheduled = true;\n    requestAnimationFrame(function () {\n      rafScheduled = false;\n      evaluateGates();\n    });\n  }\n\n  function evaluateGates() {\n    var scrollBottom = (window.scrollY || window.pageYOffset || 0) + window.innerHeight;\n    METRICS.forEach(function (m) {\n      var s = gateState[m.id];\n      if (s.seen) return;\n      if (s.anchorTop === null) return;\n      var threshold = s.anchorTop + (m.revealOffsetPx || 200);\n      if (scrollBottom >= threshold) {\n        markSeen(m.id, 'scrollBottom=' + Math.round(scrollBottom) + ' >= threshold=' + Math.round(threshold) + ' (' + s.selector + ')');\n      }\n    });\n    // If every metric has tripped, tear down listeners.\n    if (METRICS.every(function (m) { return gateState[m.id].seen; })) {\n      teardownScrollListeners();\n    }\n  }\n\n  function onScroll() { scheduleEvaluate(); }\n  function onResize() {\n    // Layout might have shifted; re-measure then re-evaluate.\n    measureAnchors();\n    scheduleEvaluate();\n  }\n\n  function setupScrollListeners() {\n    window.addEventListener('scroll', onScroll, { passive: true });\n    window.addEventListener('resize', onResize, { passive: true });\n    log('Scroll + resize listeners armed');\n  }\n\n  function teardownScrollListeners() {\n    window.removeEventListener('scroll', onScroll);\n    window.removeEventListener('resize', onResize);\n    if (measureInterval) {\n      clearInterval(measureInterval);\n      measureInterval = null;\n    }\n    log('All gates tripped — listeners torn down');\n  }\n\n  // Re-measure periodically to catch lazy hydration / image loads / etc.\n  var measureInterval = null;\n  function startPeriodicRemeasure() {\n    var ticks = 0;\n    measureInterval = setInterval(function () {\n      ticks++;\n      measureAnchors();\n      scheduleEvaluate();\n      // After 30s of measuring, stop. Anchors should be stable by then.\n      if (ticks >= 30) {\n        clearInterval(measureInterval);\n        measureInterval = null;\n        log('Periodic re-measure stopped after 30s');\n      }\n    }, 1000);\n  }\n\n  // -------------------- 6. Click delegation --------------------\n  function elMatchesAnyCta(el, ctas) {\n    for (var i = 0; i < ctas.length; i++) {\n      try {\n        var match = el.closest(ctas[i]);\n        if (match) return match;\n      } catch (e) {}\n    }\n    return null;\n  }\n\n  document.addEventListener('click', function (e) {\n    var target = e.target;\n    if (!target || !target.closest) return;\n    METRICS.forEach(function (m) {\n      var matchedEl = elMatchesAnyCta(target, m.ctas);\n      if (!matchedEl) return;\n      if (m.matchPredicate && !m.matchPredicate(matchedEl)) {\n        log('CTA matched but predicate rejected for', m.id);\n        return;\n      }\n      var s = gateState[m.id];\n      if (!s.seen) {\n        log('CTA click for', m.id, '— but gate NOT yet tripped, skipping');\n        return;\n      }\n      fireConversion(m.metricName, { metricId: m.id, cta: matchedEl });\n    });\n  }, true);\n  log('Click delegation armed for', METRICS.length, 'metrics');\n\n  // -------------------- 7. Initialize --------------------\n  function initialize() {\n    measureAnchors();\n    setupScrollListeners();\n    scheduleEvaluate(); // in case user landed already-scrolled\n    startPeriodicRemeasure();\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initialize, { once: true });\n  } else {\n    initialize();\n  }\n\n  log('Initialization complete — registry has', METRICS.length, 'metrics');\n})();","state":"active"}],"lanes":{}}
